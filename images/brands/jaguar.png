          <style>
  .free-shipping-bar-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: #000;
    padding: 12px 16px;
    font-size: 14px;
    text-align: center;
    width: 100%;
    min-width: 100%;
    margin: 10px auto;
  }

  .free-shipping-text {
    margin-top: 5px;
    color: #fff;
  }

  .free-shipping-subtext {
    font-size: 12px;
    font-weight: 400;
    color: #bbb;
    margin-top: 4px;
  }

  .free-shipping-bar-progress {
    width: 100%;
    height: 8px;
    background: #fff;
    margin: 8px 0;
    position: relative;
    overflow: hidden;
    border-radius: 999px;
  }

  .free-shipping-bar-progress div:empty {
    display: block;
  }

  .free-shipping-bar-progress div {
    height: 100%;
    background: #d2a644;
    transition: width 0.5s ease-in-out;
    border-radius: 999px;
  }

  @media (max-width: 768px) {
    .free-shipping-bar-container {
      font-size: 13px;
      padding: 10px;
    }
  }
</style>







  
  
  
  

  
  
  
  

  <div class="free-shipping-bar-container" data-threshold="3000" data-total="0" data-remaining="3000" data-formatted-remaining="30,00 €" data-success-text="Perfekt! Der Versand ist kostenlos" data-progress-text="Noch __AMOUNT__ bis zum Gratisversand">
    <div class="free-shipping-text h4">
      
        Noch 30,00 € bis zum Gratisversand
      
    </div>
    <div class="free-shipping-bar-progress">
      <div style="width: 0%;"></div>
    </div>
  </div>

<script>
(function() {
  'use strict';
  
  function updateFreeShippingBar() {
    const container = document.querySelector('.free-shipping-bar-container');
    if (!container) return;

    const threshold = parseInt(container.dataset.threshold);
    const cartTotal = parseInt(container.dataset.total);
    const formattedRemaining = container.dataset.formattedRemaining;
    const successText = container.dataset.successText;
    const progressText = container.dataset.progressText;

    const textEl = container.querySelector('.free-shipping-text');
    const barEl = container.querySelector('.free-shipping-bar-progress div');

    if (!textEl || !barEl) return;

    // Text aktualisieren
    if (cartTotal >= threshold) {
      textEl.textContent = successText;
    } else {
      textEl.textContent = progressText.replace('__AMOUNT__', formattedRemaining);
    }

    // Fortschrittsbalken aktualisieren
    const progress = Math.min(100, Math.max(0, (cartTotal * 100 / threshold)));
    barEl.style.width = progress + '%';
  }

  // Initialisierung
  function init() {
    updateFreeShippingBar();
  }

  // Event Listeners
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  document.addEventListener('cart:updated', init);
  document.addEventListener('shopify:section:load', init);
})();
</script>


          
          <div id="CartDrawer-CartItems" class="drawer__contents js-contents"><p id="CartDrawer-LiveRegionText" class="visually-hidden" role="status"></p>
